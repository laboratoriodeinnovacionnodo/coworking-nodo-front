170: export const convertBackendAreaToSeat = (area: BackendArea, reservas: BackendReserva[]) => {
171:   const activeReservas = reservas.filter((r) => r.areaId === area.id && r.fin === null)
172:   const active         = activeReservas[0]
173: 
174:   const match  = area.nombre.match(/^([A-Za-z]+)(\d+)$/)
175:   const letra  = match ? match[1].toUpperCase() : "A"
176:   const numero = match ? parseInt(match[2]) : area.id
177: 
178:   return {
179:     id:          area.nombre,
180:     backendId:   area.id,
181:     row:         letra,
182:     number:      numero,
183:     status:      ({ LIBRE: "available", OCUPADO: "occupied" }[area.estado] ?? "available") as "available" | "occupied",
184:     userName:    active?.nombre,
185:     gmail:       active?.gmail ?? undefined,
186:     reservaId:   active?.id,
187:     recepcion:   active?.recepcion,
188:     receptor:    active?.receptor ?? undefined,
189:     occupiedAt:  active?.inicio ? new Date(active.inicio) : undefined,
190:     peopleCount: activeReservas.length,
191:     zone:        letra,
192:     amenities:   area.descripcion ? [area.descripcion] : [],
193:     mapPdfUrl:   "/coworking-map.pdf",
194:   }
195: }
