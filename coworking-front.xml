167:     backendId:   area.id,
168:     row:         letra,
169:     number:      numero,
170:     status:      (reverseStatusMap[area.estado] || "available") as "available" | "occupied",
171:     userName:    activeReservas[0]?.nombre,
172:     occupiedAt:  activeReservas[0]?.inicio ? new Date(activeReservas[0].inicio) : undefined,
173:     peopleCount: activeReservas.length,
174:     zone:        letra,
175:     amenities:   area.descripcion ? [area.descripcion] : [],
176:     mapPdfUrl:   "/coworking-map.pdf",
177:   }
