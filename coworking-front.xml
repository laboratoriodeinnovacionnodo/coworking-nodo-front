  1: "use client"
  2: 
  3: /**
  4:  * hooks/use-evento-activo.ts
  5:  *
  6:  * Detecta si hay un evento del calendario-back activo AHORA MISMO
  7:  * en el área COWORKING (horario Argentina UTC-3).
  8:  *
  9:  * Hace polling cada INTERVALO_MS ms.
 10:  * Retorna el evento activo o null.
 11:  */
 12: 
 13: import { useState, useEffect, useRef, useCallback } from "react"
 14: 
 15: const EVENTOS_BASE = process.env.NEXT_PUBLIC_EVENTOS_API_URL ?? ""
 16: const INTERVALO_MS = 60_000 // 1 minuto
 17: const ESTADOS_INACTIVOS = new Set(["CANCELADO", "FINALIZADO"])
 18: 
 19: export interface EventoActivo {
 20:   id:         string
 21:   titulo:     string
 22:   fechaDesde: string
 23:   fechaHasta: string
 24:   horaDesde:  string
 25:   horaHasta:  string
 26:   tipoEvento: string
 27:   areas?:     string[]
 28:   organizadorSolicitante?: string
 29: }
 30: 
 31: // ── Helpers ──────────────────────────────────────────────────────────────────
 32: 
 33: function timeToMinutes(hhmm: string): number {
 34:   const [h, m] = hhmm.split(":").map(Number)
 35:   return h * 60 + m
 36: }
 37: 
 38: /** Hora y fecha actuales en Argentina (UTC-3), sin mutabilidad */
 39: function ahoraArgentina(): { fecha: string; minutos: number } {
 40:   const now      = new Date()
 41:   const ar       = new Date(now.getTime() - 3 * 60 * 60 * 1000)
 42:   const fecha    = ar.toISOString().split("T")[0]          // "YYYY-MM-DD"
 43:   const minutos  = ar.getUTCHours() * 60 + ar.getUTCMinutes()
 44:   return { fecha, minutos }
 45: }
 46: 
 47: /**
 48:  * Dado un evento, determina si está activo en este instante.
 49:  * Para eventos multi-día usa lógica de rango completo.
 50:  */
 51: function estaActivoAhora(ev: EventoActivo): boolean {
 52:   if (ESTADOS_INACTIVOS.has(ev.tipoEvento)) return false
 53:   if (!Array.isArray(ev.areas) || !ev.areas.includes("COWORKING")) return false
 54: 
 55:   const { fecha, minutos } = ahoraArgentina()
 56:   const evDesde = ev.fechaDesde.split("T")[0]
 57:   const evHasta = ev.fechaHasta.split("T")[0]
 58: 
 59:   // La fecha actual debe estar dentro del rango del evento
 60:   if (fecha < evDesde || fecha > evHasta) return false
 61: 
 62:   const inicioMin = timeToMinutes(ev.horaDesde)
 63:   const finMin    = timeToMinutes(ev.horaHasta)
 64: 
 65:   if (evDesde === evHasta) {
 66:     // Mismo día: verificar rango horario exacto
 67:     return minutos >= inicioMin && minutos < finMin
 68:   }
 69: 
 70:   // Multi-día
 71:   if (fecha === evDesde) return minutos >= inicioMin   // primer día: desde la hora de inicio
 72:   if (fecha === evHasta) return minutos < finMin        // último día: hasta la hora de fin
 73:   return true                                           // días intermedios: todo el día
 74: }
 75: 
 76: // ── Hook ─────────────────────────────────────────────────────────────────────
 77: 
 78: export function useEventoActivo() {
 79:   const [eventoActivo, setEventoActivo] = useState<EventoActivo | null>(null)
 80:   const [cargando,     setCargando]     = useState(true)
 81:   const intervalRef                     = useRef<ReturnType<typeof setInterval> | null>(null)
 82: 
 83:   const verificar = useCallback(async () => {
 84:     if (!EVENTOS_BASE) { setCargando(false); return }
 85: 
 86:     try {
 87:       const { fecha } = ahoraArgentina()
 88:       const [y, m]    = fecha.split("-").map(Number)
 89: 
 90:       // Consultar mes actual (y el siguiente si estamos en los últimos días del mes)
 91:       const meses: { y: number; m: number }[] = [{ y, m }]
 92:       const diasEnMes = new Date(y, m, 0).getDate()
 93:       const diaActual = Number(fecha.split("-")[2])
 94:       if (diasEnMes - diaActual <= 3) {
 95:         meses.push(m === 12 ? { y: y + 1, m: 1 } : { y, m: m + 1 })
 96:       }
 97: 
 98:       const resultados = await Promise.all(
 99:         meses.map(({ y, m }) =>
100:           fetch(`${EVENTOS_BASE}/calendar?year=${y}&month=${m}`, { cache: "no-store" })
101:             .then((r) => r.ok ? r.json() : { events: [] })
102:             .then((d) => (d.events ?? []) as EventoActivo[])
103:             .catch(() => [] as EventoActivo[])
104:         )
105:       )
106: 
107:       const todos = resultados.flat()
108:       const activo = todos.find(estaActivoAhora) ?? null
109:       setEventoActivo(activo)
110:     } catch {
111:       // silencioso — no romper la UI si el calendario-back falla
112:     } finally {
113:       setCargando(false)
114:     }
115:   }, [])
116: 
117:   useEffect(() => {
118:     verificar()
119:     intervalRef.current = setInterval(verificar, INTERVALO_MS)
120:     return () => {
121:       if (intervalRef.current) clearInterval(intervalRef.current)
122:     }
123:   }, [verificar])
124: 
125:   return { eventoActivo, cargando }
126: }
