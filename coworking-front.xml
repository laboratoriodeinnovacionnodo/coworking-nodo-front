15:   admin: Admin | null
16:   isAdmin: boolean
17:   login: (email: string, password: string) => Promise<void>
18:   logout: () => void
19:   loading: boolean
20: }
21: 
22: const AuthContext = createContext<AuthContextType | undefined>(undefined)
23: 
24: export function AuthProvider({ children }: { children: ReactNode }) {
25:   const [admin, setAdmin] = useState<Admin | null>(null)
26:   const [loading, setLoading] = useState(true)
27:   const router = useRouter()
28:   const { toast } = useToast()
29: 
30:   useEffect(() => {
31:     const storedAdmin = localStorage.getItem("coworking_admin")
32:     if (storedAdmin) {
33:       try {
34:         setAdmin(JSON.parse(storedAdmin))
35:       } catch (error) {
36:         console.error("Error parsing stored admin:", error)
37:         localStorage.removeItem("coworking_admin")
38:       }
39:     }
40:     setLoading(false)
41:   }, [])
42: 
43:   const login = async (email: string, password: string) => {
44:     try {
45:       const data = await adminsApi.login(email, password)
46: 
47:       const adminData: Admin = {
48:         id: data.id,
49:         nombre: data.nombre,
50:         email: data.email,
51:       }
52: 
53:       setAdmin(adminData)
54:       localStorage.setItem("coworking_admin", JSON.stringify(adminData))
55: 
56:       toast({
57:         title: "Ingreso exitoso",
58:         description: `Bienvenido al sistema, ${adminData.nombre}`,
59:       })
60: 
61:       router.push("/")
62:     } catch (error) {
63:       console.error("Login error:", error)
64:       throw error
65:     }
66:   }
67: 
68:   const logout = () => {
69:     setAdmin(null)
70:     localStorage.removeItem("coworking_admin")
71: 
72:     toast({
73:       title: "Sesión cerrada",
74:       description: "Has cerrado sesión exitosamente",
75:     })
76: 
77:     router.push("/login")
78:   }
79: 
80:   return (
81:     <AuthContext.Provider value={{ admin, isAdmin: admin !== null, login, logout, loading }}>
82:       {children}
83:     </AuthContext.Provider>
84:   )
85: }
86: 
87: export function useAuth() {
88:   const context = useContext(AuthContext)
89:   if (context === undefined) {
90:     throw new Error("useAuth debe usarse dentro de AuthProvider")
91:   }
92:   return context
93: }
