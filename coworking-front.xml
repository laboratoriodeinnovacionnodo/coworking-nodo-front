 54:   const minNow = ar.getUTCHours() * 60 + ar.getUTCMinutes()
 55:   const fechaHoy = `${ar.getUTCFullYear()}-${String(ar.getUTCMonth() + 1).padStart(2, "0")}-${String(ar.getUTCDate()).padStart(2, "0")}`
