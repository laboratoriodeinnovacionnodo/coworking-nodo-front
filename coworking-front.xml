154: export const convertBackendAreaToSeat = (area: BackendArea, reservas: BackendReserva[]) => {
155:   const activeReservas = reservas.filter((r) => r.areaId === area.id && r.fin === null)
156: 
157:   let row = ""
158:   let number = 0
159:   const match = area.nombre.match(/^([A-Z])(\d+)$/)
160:   if (match) {
161:     row = match[1]
162:     number = parseInt(match[2])
163:   } else {
164:     row = String.fromCharCode(65 + Math.floor((area.id - 1) / 10))
165:     number = ((area.id - 1) % 10) + 1
166:   }
167: 
168:   return {
169:     id:         area.nombre,
170:     backendId:  area.id,
171:     row,
172:     number,
173:     status:     (reverseStatusMap[area.estado] || "available") as "available" | "occupied",
174:     userName:   activeReservas[0]?.nombre,
175:     occupiedAt: activeReservas[0]?.inicio ? new Date(activeReservas[0].inicio) : undefined,
176:     peopleCount: activeReservas.length,
177:     image:      `/placeholder.svg?height=300&width=400`,
178:     capacity:   2,
179:     zone:       area.descripcion || "Zona Principal",
180:     amenities:  ['Monitor 24"', "Enchufe USB-C", "Iluminación LED"],
181:     mapPdfUrl:  "/coworking-map.pdf",
182:   }
183: }
