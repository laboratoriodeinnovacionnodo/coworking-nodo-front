24: 
25: const pkgPath = "package.json";
26: const pkg = JSON.parse(fs.readFileSync(pkgPath, "utf8"));
27: 
28: const directDeps = {
29:   ...(pkg.dependencies || {}),
30:   ...(pkg.devDependencies || {})
31: };
32: 
33: // Overrides candidatos originales (formato pnpm: "pkg@range")
34: const rawOverrides = pkg.overrides || (pkg.pnpm && pkg.pnpm.overrides) || {};
35: 
36: const cleanOverrides = {};
37: 
38: for (const [key, value] of Object.entries(rawOverrides)) {
39:   // key puede venir como "next@>=16.0.0 <16.2.11" o simplemente "next"
40:   const pkgName = key.split("@")[0].trim() || key.split(/@(?!.*@)/)[0];
41:   const realName = key.startsWith("@") ? key.split("@").slice(0,2).join("@") : key.split("@")[0];
42: 
43:   if (directDeps[realName]) {
44:     console.log(`⏭️  Omitiendo override "${key}" — "${realName}" ya es dependencia directa (${directDeps[realName]}), no se necesita override.`);
45:     continue;
46:   }
47: 
48:   // Si no hay conflicto, guardamos el override tal cual (formato simple, sin rango)
49:   cleanOverrides[realName] = value;
50: }
51: 
52: pkg.overrides = cleanOverrides;
53: 
