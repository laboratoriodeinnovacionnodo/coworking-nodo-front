74:       description: "Has cerrado sesión exitosamente",
75:     })
76: 
77:     router.push("/login")
78:   }
79: 
80:   return (
81:     <AuthContext.Provider value={{ admin, isAdmin: admin !== null, login, logout, loading }}>
82:       {children}
83:     </AuthContext.Provider>
84:   )
85: }
