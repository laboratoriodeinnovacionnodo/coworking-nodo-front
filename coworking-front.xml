 69: function rangoHorarioSolapa(hDA: string, hHA: string, hDB: string, hHB: string): boolean {
 70:   return timeToMinutes(hDA) < timeToMinutes(hHB) && timeToMinutes(hHA) > timeToMinutes(hDB)
 71: }
 72: 
 73: function calcularConflictos(
 74:   ocupaciones: Ocupacion[],
 75:   eventosCalendario: EventoCalendario[],
 76:   todasLasAreas: BackendArea[],
 77:   fechaDesde: string,
 78:   fechaHasta: string,
 79:   horaDesde: string,
 80:   horaHasta: string,
 81: ): { areaIds: Set<number>; eventosBloqueantes: EventoCalendario[] } {
 82:   const areaIds: Set<number> = new Set()
 83:   const eventosBloqueantes: EventoCalendario[] = []
 84: 
 85:   if (!fechaDesde || !fechaHasta || !horaDesde || !horaHasta) return { areaIds, eventosBloqueantes }
 86:   if (timeToMinutes(horaDesde) >= timeToMinutes(horaHasta))  return { areaIds, eventosBloqueantes }
 87: 
 88:   for (const oc of ocupaciones) {
 89:     const ocD = oc.fechaDesde.split("T")[0]
 90:     const ocH = oc.fechaHasta.split("T")[0]
 91:     if (!rangoFechasSolapa(fechaDesde, fechaHasta, ocD, ocH)) continue
 92:     if (!rangoHorarioSolapa(horaDesde, horaHasta, oc.horaDesde, oc.horaHasta)) continue
 93:     oc.areas.forEach((r) => areaIds.add(r.areaId))
 94:   }
 95: 
 96:   for (const ev of eventosCalendario) {
 97:     const evD = ev.fechaDesde.split("T")[0]
 98:     const evH = ev.fechaHasta.split("T")[0]
 99:     if (!rangoFechasSolapa(fechaDesde, fechaHasta, evD, evH)) continue
100:     if (!rangoHorarioSolapa(horaDesde, horaHasta, ev.horaDesde, ev.horaHasta)) continue
101:     todasLasAreas.forEach((a) => areaIds.add(a.id))
102:     eventosBloqueantes.push(ev)
103:   }
104: 
105:   return { areaIds, eventosBloqueantes }
106: }
