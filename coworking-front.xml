48:         id: data.id,
49:         nombre: data.nombre,
50:         email: data.email,
51:       }
52: 
53:       setAdmin(adminData)
54:       localStorage.setItem("coworking_admin", JSON.stringify(adminData))
55: 
56:       toast({
57:         title: "Ingreso exitoso",
58:         description: `Bienvenido al sistema, ${adminData.nombre}`,
59:       })
60: 
61:       router.push("/")
62:     } catch (error) {
63:       console.error("Login error:", error)
64:       throw error
65:     }
66:   }
67: 
68:   const logout = () => {
69:     setAdmin(null)
70:     localStorage.removeItem("coworking_admin")
71: 
72:     toast({
