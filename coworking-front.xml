  1: "use client"
  2: 
  3: /**
  4:  * hooks/use-evento-activo.ts
  5:  *
  6:  * Detecta si hay un evento del calendario-back activo AHORA MISMO
  7:  * en el área COWORKING (horario Argentina UTC-3).
  8:  *
  9:  * Polling cada INTERVALO_MS con AbortController para cancelar
 10:  * fetches en vuelo al desmontar — evita race conditions al navegar.
 11:  */
 12: 
 13: import { useState, useEffect, useRef } from "react"
 14: 
 15: const EVENTOS_BASE    = process.env.NEXT_PUBLIC_EVENTOS_API_URL ?? ""
 16: const INTERVALO_MS    = 60_000
 17: const ESTADOS_INACTIVOS = new Set(["CANCELADO", "FINALIZADO"])
 18: 
 19: export interface EventoActivo {
 20:   id:          string
 21:   titulo:      string
 22:   fechaDesde:  string
 23:   fechaHasta:  string
 24:   horaDesde:   string
 25:   horaHasta:   string
 26:   tipoEvento:  string
 27:   areas?:      string[]
 28:   organizadorSolicitante?: string
 29: }
 30: 
 31: // ── Helpers ──────────────────────────────────────────────────────────────────
 32: 
 33: function timeToMinutes(hhmm: string): number {
 34:   const [h, m] = hhmm.split(":").map(Number)
 35:   return h * 60 + m
 36: }
 37: 
 38: function ahoraArgentina(): { fecha: string; minutos: number } {
 39:   const ar      = new Date(Date.now() - 3 * 60 * 60 * 1000)
 40:   const fecha   = ar.toISOString().split("T")[0]
 41:   const minutos = ar.getUTCHours() * 60 + ar.getUTCMinutes()
 42:   return { fecha, minutos }
 43: }
 44: 
 45: function estaActivoAhora(ev: EventoActivo): boolean {
 46:   if (ESTADOS_INACTIVOS.has(ev.tipoEvento)) return false
 47:   if (!Array.isArray(ev.areas) || !ev.areas.includes("COWORKING")) return false
 48: 
 49:   const { fecha, minutos } = ahoraArgentina()
 50:   const evDesde = ev.fechaDesde.split("T")[0]
 51:   const evHasta = ev.fechaHasta.split("T")[0]
 52: 
 53:   if (fecha < evDesde || fecha > evHasta) return false
 54: 
 55:   const inicioMin = timeToMinutes(ev.horaDesde)
 56:   const finMin    = timeToMinutes(ev.horaHasta)
 57: 
 58:   if (evDesde === evHasta) return minutos >= inicioMin && minutos < finMin
 59:   if (fecha === evDesde)   return minutos >= inicioMin
 60:   if (fecha === evHasta)   return minutos < finMin
 61:   return true
 62: }
 63: 
 64: async function fetchEventoActivo(signal: AbortSignal): Promise<EventoActivo | null> {
 65:   if (!EVENTOS_BASE) return null
 66: 
 67:   try {
 68:     const { fecha } = ahoraArgentina()
 69:     const [y, m]    = fecha.split("-").map(Number)
 70: 
 71:     // Consultar mes actual y el siguiente si estamos cerca del fin de mes
 72:     const meses: { y: number; m: number }[] = [{ y, m }]
 73:     const diasEnMes = new Date(y, m, 0).getDate()
 74:     const diaActual = Number(fecha.split("-")[2])
 75:     if (diasEnMes - diaActual <= 3) {
 76:       meses.push(m === 12 ? { y: y + 1, m: 1 } : { y, m: m + 1 })
 77:     }
 78: 
 79:     const resultados = await Promise.all(
 80:       meses.map(async ({ y, m }) => {
 81:         try {
 82:           const res = await fetch(
 83:             `${EVENTOS_BASE}/calendar?year=${y}&month=${m}`,
 84:             { cache: "no-store", signal }
 85:           )
 86:           if (!res.ok) return []
 87:           const data = await res.json()
 88:           return (data.events ?? []) as EventoActivo[]
 89:         } catch {
 90:           return []
 91:         }
 92:       })
 93:     )
 94: 
 95:     const todos = resultados.flat()
 96: 
 97:     // Deduplicar
 98:     const vistos = new Set<string>()
 99:     const unicos = todos.filter((e) => {
100:       if (vistos.has(e.id)) return false
101:       vistos.add(e.id)
102:       return true
103:     })
104: 
105:     return unicos.find(estaActivoAhora) ?? null
106:   } catch (err) {
107:     // AbortError es esperado al desmontar — ignorar silenciosamente
108:     if (err instanceof DOMException && err.name === "AbortError") return null
109:     return null
110:   }
111: }
112: 
113: // ── Hook ─────────────────────────────────────────────────────────────────────
114: 
115: export function useEventoActivo() {
116:   const [eventoActivo, setEventoActivo] = useState<EventoActivo | null>(null)
117:   const [cargando,     setCargando]     = useState(true)
118: 
119:   // Ref para el AbortController activo y el intervalo
120:   const abortRef    = useRef<AbortController | null>(null)
121:   const intervalRef = useRef<ReturnType<typeof setInterval> | null>(null)
122: 
123:   useEffect(() => {
124:     let montado = true
125: 
126:     const ejecutar = async () => {
127:       // Cancelar fetch anterior si sigue en vuelo
128:       if (abortRef.current) abortRef.current.abort()
129:       abortRef.current = new AbortController()
130: 
131:       const activo = await fetchEventoActivo(abortRef.current.signal)
132: 
133:       // Solo actualizar estado si el componente sigue montado
134:       if (montado) {
135:         setEventoActivo(activo)
136:         setCargando(false)
137:       }
138:     }
139: 
140:     // Ejecución inmediata
141:     ejecutar()
142: 
143:     // Polling
144:     intervalRef.current = setInterval(ejecutar, INTERVALO_MS)
145: 
146:     return () => {
147:       // Cleanup al desmontar: cancelar fetch en vuelo + limpiar intervalo
148:       montado = false
149:       if (abortRef.current) {
150:         abortRef.current.abort()
151:         abortRef.current = null
152:       }
153:       if (intervalRef.current) {
154:         clearInterval(intervalRef.current)
155:         intervalRef.current = null
156:       }
157:     }
158:   }, []) // sin dependencias → solo monta/desmonta una vez
159: 
160:   return { eventoActivo, cargando }
161: }
