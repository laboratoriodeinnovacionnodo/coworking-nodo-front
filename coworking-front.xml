 42:     if (!seat.backendId) throw new Error("Asiento sin ID de backend")
 43: 
 44:     try {
 45:       if (newStatus === "occupied" || newStatus === "for-share" || newStatus === "shared") {
 46:         if (!userName) throw new Error("Nombre de usuario requerido")
 47: 
 48:         const user = await (async () => {
 49:           try {
 50:             const res = await fetch(
 51:               `${process.env.NEXT_PUBLIC_API_URL ?? ""}/usuario`,
 52:               { headers: { "Content-Type": "application/json" } }
 53:             )
 54:             if (!res.ok) return null
 55:             const usuarios = await res.json()
 56:             return usuarios.find((u: { nombre: string; id: number }) => u.nombre === userName) ?? null
 57:           } catch { return null }
 58:         })()
 59: 
 60:         const usuarioId = user?.id ?? 1
 61:         const detalles  =
 62:           newStatus === "for-share"
 63:             ? `Para compartir (límite: ${shareLimit || 6}, personas: ${peopleCount})`
 64:             : `Ocupado por ${peopleCount} persona(s)`
 65: 
 66:         await reservasApi.create({
 67:           nombre: userName,
 68:           detalles,
 69:           usuarioId,
 70:           areaId: seat.backendId,
 71:           ...(recepcion && { recepcion }),
 72:           ...(receptor  && { receptor }),
 73:           ...(gmail     && { gmail }),
 74:         })
 75: 
 76:         if (newStatus === "for-share") {
 77:           const reservas    = await reservasApi.getAll()
 78:           const activeCount = reservas.filter((r) => r.areaId === seat.backendId && r.fin === null).length
 79:           await areasApi.cambiarEstado(seat.backendId, activeCount >= (shareLimit || 6) ? "shared" : newStatus)
 80:         } else {
 81:           await areasApi.cambiarEstado(seat.backendId, newStatus)
 82:         }
 83: 
 84:         toastRef.current({ title: "Reserva creada", description: `${seat.id} asignado a ${userName}` })
 85:       } else {
 86:         await areasApi.cambiarEstado(seat.backendId, newStatus)
 87:         toastRef.current({ title: "Estado actualizado", description: `${seat.id} cambió de estado` })
 88:       }
 89: 
 90:       await fetchSeats()
 91:     } catch (err) {
 92:       const msg = err instanceof Error ? err.message : "Error al actualizar"
 93:       setError(msg)
 94:       toastRef.current({ variant: "destructive", title: "Error al actualizar asiento", description: msg })
 95:       throw err
