260:   // Filtrar reservas activas de esta área (sin fecha fin)
261:   const activeReservas = reservas.filter((r) => r.areaId === area.id && r.fin === null)
262: 
263:   // Extraer fila y número del nombre si tiene formato "A1", sino usar el ID
264:   let row = ""
265:   let number = 0
266: 
267:   const match = area.nombre.match(/^([A-Z])(\d+)$/)
268:   if (match) {
269:     row = match[1]
270:     number = Number.parseInt(match[2])
271:   } else {
272:     // Para nombres descriptivos, usar el ID
273:     row = String.fromCharCode(65 + Math.floor((area.id - 1) / 10))
274:     number = ((area.id - 1) % 10) + 1
275:   }
276: 
277:   // Calcular cantidad de personas compartiendo
278:   const peopleCount = activeReservas.length
279: 
280:   return {
281:     id: area.nombre,
282:     backendId: area.id,
283:     row,
284:     number,
285:     status: reverseStatusMap[area.estado] || "available",
286:     userName: activeReservas[0]?.nombre,
287:     occupiedAt: activeReservas[0]?.inicio ? new Date(activeReservas[0].inicio) : undefined,
288:     sharedUsers: activeReservas.map((r) => r.nombre),
289:     shareLimit: area.estado === "PARA_COMPARTIR" ? 6 : undefined, // Default limit
290:     peopleCount,
291:     // Datos adicionales para display
292:     image: `/placeholder.svg?height=300&width=400&query=modern coworking desk ${area.nombre}`,
293:     capacity: 2, // Default capacity
294:     zone: area.descripcion || "Zona Principal",
295:     amenities: ['Monitor 24"', "Enchufe USB-C", "Iluminación LED"],
