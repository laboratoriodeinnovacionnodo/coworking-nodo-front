 49:     const ini = timeToMinutes(oc.horaDesde)
 50:     const fin = timeToMinutes(oc.horaHasta)
 51:     if (minNow >= fin)  return "vencida"
 52:     if (minNow >= ini)  return "en-curso"
 53:     return "proxima"
 54:   }
 55:   if (ocDesde === fechaHoy) return minNow >= timeToMinutes(oc.horaDesde) ? "en-curso" : "proxima"
 56:   return minNow < timeToMinutes(oc.horaHasta) ? "en-curso" : "vencida"
 57: }
