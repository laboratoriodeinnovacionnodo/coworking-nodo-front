  1: "use client"
  2: 
  3: import { useState, useCallback, useRef, useEffect } from "react"
  4: import { areasApi, reservasApi, convertBackendAreaToSeat } from "@/lib/api"
  5: import type { Seat } from "@/types/seat"
  6: import { useToast } from "@/hooks/use-toast"
  7: 
  8: // Polling cada 30s — suficiente para datos en tiempo real sin saturar la DB
  9: const POLLING_MS = 30_000
 10: 
 11: export function useSeats() {
 12:   const { toast }    = useToast()
 13:   const toastRef     = useRef(toast)
 14:   useEffect(() => { toastRef.current = toast }, [toast])
 15: 
 16:   const [seats,   setSeats]   = useState<Seat[]>([])
 17:   const [loading, setLoading] = useState(false)
 18:   const [error,   setError]   = useState<string | null>(null)
 19: 
 20:   // ── fetchSeats: estable, no se recrea entre renders ──────────────────────
 21:   const fetchSeats = useCallback(async () => {
 22:     try {
 23:       setLoading(true)
 24:       setError(null)
 25:       const [areas, reservas] = await Promise.all([
 26:         areasApi.getAll(),
 27:         reservasApi.getAll(),
 28:       ])
 29:       setSeats(areas.map((area) => convertBackendAreaToSeat(area, reservas)))
 30:     } catch (err) {
 31:       const msg = err instanceof Error ? err.message : "Error al cargar áreas"
 32:       setError(msg)
 33:     } finally {
 34:       setLoading(false)
 35:     }
 36:   }, []) // sin deps → referencia estable entre renders
 37: 
 38:   // ── updateSeatStatus ─────────────────────────────────────────────────────
 39:   const updateSeatStatus = useCallback(async (
 40:     seat: Seat,
 41:     newStatus: string,
 42:     userName?: string,
 43:     peopleCount?: number,
 44:     shareLimit?: number,
 45:   ) => {
 46:     if (!seat.backendId) throw new Error("Asiento sin ID de backend")
 47: 
 48:     try {
 49:       if (newStatus === "occupied" || newStatus === "for-share" || newStatus === "shared") {
 50:         if (!userName) throw new Error("Nombre de usuario requerido")
 51: 
 52:         // Buscar usuario por nombre
 53:         const user = await (async () => {
 54:           try {
 55:             const res = await fetch(
 56:               `${process.env.NEXT_PUBLIC_API_URL ?? ""}/usuario`,
 57:               { headers: { "Content-Type": "application/json" } }
 58:             )
 59:             if (!res.ok) return null
 60:             const usuarios = await res.json()
 61:             return usuarios.find((u: { nombre: string; id: number }) => u.nombre === userName) ?? null
 62:           } catch { return null }
 63:         })()
 64: 
 65:         const usuarioId = user?.id ?? 1
 66:         const detalles  =
 67:           newStatus === "for-share"
 68:             ? `Para compartir (límite: ${shareLimit || 6}, personas: ${peopleCount})`
 69:             : `Ocupado por ${peopleCount} persona(s)`
 70: 
 71:         await reservasApi.create({ nombre: userName, detalles, usuarioId, areaId: seat.backendId })
 72: 
 73:         if (newStatus === "for-share") {
 74:           const reservas    = await reservasApi.getAll()
 75:           const activeCount = reservas.filter((r) => r.areaId === seat.backendId && r.fin === null).length
 76:           await areasApi.cambiarEstado(seat.backendId, activeCount >= (shareLimit || 6) ? "shared" : newStatus)
 77:         } else {
 78:           await areasApi.cambiarEstado(seat.backendId, newStatus)
 79:         }
 80: 
 81:         toastRef.current({ title: "Reserva creada", description: `${seat.id} asignado a ${userName}` })
 82:       } else {
 83:         await areasApi.cambiarEstado(seat.backendId, newStatus)
 84:         toastRef.current({ title: "Estado actualizado", description: `${seat.id} cambió de estado` })
 85:       }
 86: 
 87:       await fetchSeats()
 88:     } catch (err) {
 89:       const msg = err instanceof Error ? err.message : "Error al actualizar"
 90:       setError(msg)
 91:       toastRef.current({ variant: "destructive", title: "Error al actualizar asiento", description: msg })
 92:       throw err
 93:     }
 94:   }, [fetchSeats])
 95: 
 96:   // ── toggleBlockAll ───────────────────────────────────────────────────────
 97:   const toggleBlockAll = useCallback(async (block: boolean) => {
 98:     try {
 99:       setLoading(true)
100:       await areasApi.bloquearTodas(block)
101:       toastRef.current({
102:         title:       block ? "Coworking bloqueado" : "Coworking desbloqueado",
103:         description: block ? "Todas las áreas están bloqueadas" : "Las áreas volvieron a su estado libre",
104:       })
105:       await fetchSeats()
106:     } catch (err) {
107:       const msg = err instanceof Error ? err.message : "Error al operar"
108:       setError(msg)
109:       toastRef.current({ variant: "destructive", title: "Error", description: msg })
110:     } finally {
111:       setLoading(false)
112:     }
113:   }, [fetchSeats])
114: 
115:   return { seats, loading, error, fetchSeats, updateSeatStatus, toggleBlockAll, POLLING_MS }
116: }
