```typescript
 1: /**
 2:  * lib/eventos-api.ts
 3:  * Cliente de solo-lectura para el calendario-back (NEXT_PUBLIC_EVENTOS_API_URL).
 4:  * Se usa únicamente para verificar conflictos al agendar ocupaciones.
 5:  */
 6: 
 7: const EVENTOS_BASE =
 8:   process.env.NEXT_PUBLIC_EVENTOS_API_URL ?? ""
 9: 
10: // Estados que NO bloquean el agendado (el evento ya no está vigente)
11: const ESTADOS_INACTIVOS = new Set(["CANCELADO", "FINALIZADO"])
12: 
13: export interface EventoCalendario {
14:   id:          string
15:   titulo:      string
16:   fechaDesde:  string   // ISO o "YYYY-MM-DD"
17:   fechaHasta:  string
18:   horaDesde:   string   // "HH:mm"
19:   horaHasta:   string
20:   tipoEvento:  string
21:   areas?:      string[] // e.g. ["COWORKING", "AUDITORIO"]
22: }
23: 
24: interface CalendarResponse {
25:   events:      EventoCalendario[]
26:   totalEvents: number
27: }
28: 
29: /**
30:  * Trae los eventos del calendario-back para un rango de meses.
31:  * Necesitamos cubrir un rango porque el usuario puede agendar a futuro
32:  * cruzando meses (fechaDesde en un mes, fechaHasta en otro).
33:  */
34: async function fetchEventosMes(year: number, month: number): Promise<EventoCalendario[]> {
35:   if (!EVENTOS_BASE) return []
36:   try {
37:     const res = await fetch(
38:       `${EVENTOS_BASE}/calendar?year=${year}&month=${month}`,
39:       { cache: "no-store" },
40:     )
41:     if (!res.ok) return []
42:     const data: CalendarResponse = await res.json()
43:     return data.events ?? []
44:   } catch {
45:     return []
46:   }
47: }
48: 
49: /**
50:  * Retorna los eventos activos del calendario-back que:
51:  *   · tengan área COWORKING
52:  *   · NO estén CANCELADOS ni FINALIZADOS
53:  *   · su rango de fechas se superponga con [desde, hasta]
54:  *
55:  * Cubre hasta 3 meses para soportar rangos multi-mes.
56:  */
57: export async function getEventosActivosCoworking(
58:   fechaDesde: string,
59:   fechaHasta: string,
60: ): Promise<EventoCalendario[]> {
61:   if (!EVENTOS_BASE || !fechaDesde || !fechaHasta) return []
62: 
63:   // Determinar los meses a consultar
64:   const [yD, mD] = fechaDesde.split("-").map(Number)
65:   const [yH, mH] = fechaHasta.split("-").map(Number)
66: 
67:   const meses: { year: number; month: number }[] = []
68:   let y = yD, m = mD
69:   while (y < yH || (y === yH && m <= mH)) {
70:     meses.push({ year: y, month: m })
71:     m++
72:     if (m > 12) { m = 1; y++ }
73:     if (meses.length > 6) break // límite de seguridad
74:   }
75: 
76:   const resultados = await Promise.all(meses.map(({ year, month }) => fetchEventosMes(year, month)))
77:   const todos = resultados.flat()
78: 
79:   // Deduplicar por id
80:   const vistos = new Set<string>()
81:   const deduplicados = todos.filter((e) => {
82:     if (vistos.has(e.id)) return false
83:     vistos.add(e.id)
84:     return true
85:   })
86: 
87:   return deduplicados.filter((e) => {
88:     // Solo eventos activos con área COWORKING
89:     if (ESTADOS_INACTIVOS.has(e.tipoEvento)) return false
90:     if (!Array.isArray(e.areas) || !e.areas.includes("COWORKING")) return false
91: 
92:     // Superposición de fechas con el rango pedido
93:     const evDesde = e.fechaDesde.split("T")[0]
94:     const evHasta = e.fechaHasta.split("T")[0]
95:     return evDesde <= fechaHasta && evHasta >= fechaDesde
96:   })
97: }
