885:       const [areas, reservas] = await Promise.all([areasApi.getAll(), reservasApi.getAll()])
886:       setSeats(areas.map((area) => convertBackendAreaToSeat(area, reservas)))
887:     } catch (err) {
888:       setError(err instanceof Error ? err.message : "Error al cargar áreas")
889:     } finally {
890:       setLoading(false)
891:     }
892:   }, [])
893: 
894:   const updateSeatStatus = useCallback(async (
895:     seat:         Seat,
896:     newStatus:    string,
897:     userName?:    string,
898:     peopleCount?: number,
899:     shareLimit?:  number,
900:     recepcion?:   Recepcion,
901:     receptor?:    string,
902:     gmail?:       string,
903:   ) => {
904:     if (!seat.backendId) throw new Error("Asiento sin ID de backend")
905: 
906:     try {
907:       if (newStatus === "occupied" || newStatus === "for-share" || newStatus === "shared") {
908:         if (!userName) throw new Error("Nombre de usuario requerido")
909: 
910:         const user = await (async () => {
911:           try {
912:             const res = await fetch(
913:               `${process.env.NEXT_PUBLIC_API_URL ?? ""}/usuario`,
914:               { headers: { "Content-Type": "application/json" } }
915:             )
916:             if (!res.ok) return null
917:             const usuarios = await res.json()
918:             return usuarios.find((u: { nombre: string; id: number }) => u.nombre === userName) ?? null
919:           } catch { return null }
920:         })()
921: 
922:         const usuarioId = user?.id ?? 1
923:         const detalles  =
924:           newStatus === "for-share"
925:             ? `Para compartir (límite: ${shareLimit || 6}, personas: ${peopleCount})`
926:             : `Ocupado por ${peopleCount} persona(s)`
927: 
928:         await reservasApi.create({
929:           nombre: userName,
930:           detalles,
931:           usuarioId,
932:           areaId: seat.backendId,
933:           ...(recepcion && { recepcion }),
934:           ...(receptor  && { receptor }),
935:           ...(gmail     && { gmail }),
936:         })
937: 
938:         if (newStatus === "for-share") {
939:           const reservas    = await reservasApi.getAll()
940:           const activeCount = reservas.filter((r) => r.areaId === seat.backendId && r.fin === null).length
941:           await areasApi.cambiarEstado(seat.backendId, activeCount >= (shareLimit || 6) ? "shared" : newStatus)
942:         } else {
943:           await areasApi.cambiarEstado(seat.backendId, newStatus)
944:         }
