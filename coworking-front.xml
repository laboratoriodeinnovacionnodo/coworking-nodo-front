286: export const convertBackendAreaToSeat = (area: BackendArea, reservas: BackendReserva[]) => {
287:   const activeReservas = reservas.filter((r) => r.areaId === area.id && r.fin === null)
288:   const active         = activeReservas[0]
289: 
290:   const match  = area.nombre.match(/^([A-Za-z]+)(\d+)$/)
291:   const letra  = match ? match[1].toUpperCase() : "A"
292:   const numero = match ? parseInt(match[2]) : area.id
293: 
294:   return {
295:     id:          area.nombre,
296:     backendId:   area.id,
297:     row:         letra,
298:     number:      numero,
299:     status:      ({ LIBRE: "available", OCUPADO: "occupied" }[area.estado] ?? "available") as "available" | "occupied",
300:     userName:    active?.nombre,
301:     gmail:       active?.gmail ?? undefined,
302:     reservaId:   active?.id,
303:     recepcion:   active?.recepcion,
304:     receptor:    active?.receptor ?? undefined,
305:     occupiedAt:  active?.inicio ? new Date(active.inicio) : undefined,
306:     peopleCount: activeReservas.length,
307:     zone:        letra,
308:     amenities:   area.descripcion ? [area.descripcion] : [],
309:     mapPdfUrl:   "/coworking-map.pdf",
310:   }
311: }
